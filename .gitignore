# Flutter / Dart 缓存与生成状态
/.dart_tool/
/.packages
/.pub/
/.pub-cache/
/.flutter-plugins
/.flutter-plugins-dependencies

# 构建、测试产物和发布包
/build/
/dist/
/coverage/

# 本地文档，不纳入版本控制
/docs/

# Windows Flutter 临时文件
/windows/flutter/ephemeral/

# IDE 本机状态与配置，不纳入版本控制
.idea/
*.iml
.vs/
.vscode/

# Visual Studio 用户配置
*.suo
*.user
*.userosscache
*.sln.docstates

# 日志、编辑器临时文件和系统杂项
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# 本项目是应用：保留 pubspec.lock、.metadata、源码、测试和 Windows manifest。
